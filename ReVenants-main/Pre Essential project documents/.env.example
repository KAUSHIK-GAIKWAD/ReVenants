# Telegram Bot Configuration
# Obtain via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase database configuration
# Create a project at https://supabase.com and copy these values from Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Optional App Settings
# Telegram ingestion mode: polling (local dev / offline demo) or webhook (production)
MODE=polling
# Required only if MODE=webhook
# WEBHOOK_URL=https://your-domain.railway.app/webhook
# WEBHOOK_SECRET=your_webhook_secret_here

# LOG_LEVEL=INFO
# DASHBOARD_PORT=8000

